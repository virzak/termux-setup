# Copy to local.env (gitignored) and fill in. All values are optional.

# Name Termux should go by: $USER, the bash prompt, and the default ssh login name.
# Termux itself runs as u0_aNNN, which can't be changed.
USER_NAME=me

# Public key of the PC that should be able to ssh into the phone (contents of ~/.ssh/id_rsa.pub).
PC_KEY='ssh-ed25519 AAAA... you@pc'

# DNS for pwsh inside proot Debian: your LAN resolver and search domain, so bare host names resolve.
DNS_SERVER=192.168.1.1
DNS_SEARCH=example.ts.net

# Host part of the bash prompt (<user>@<name>). Defaults to the phone model, e.g. sm-s918w.
#DEVICE_NAME=pixel

# Windows PCs (ssh host names) that get a hibernate-<host> Termux:Widget shortcut.
HIBERNATE_HOSTS="desktop laptop"
